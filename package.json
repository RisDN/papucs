{
  "name": "papucs-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:content": "node scripts/check-forbidden-content.mjs",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "pack:check": "npm pack --dry-run --workspace papucs && npm pack --dry-run --workspace create-papucs",
    "release:check": "node scripts/check-release-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "description": "Papucs is a local-first Minecraft server development and OCI image build CLI. It turns versioned layers and server definitions into disposable local Docker Compose runtimes, supports incremental synchronization, and builds images for handoff to any runtime platform.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
